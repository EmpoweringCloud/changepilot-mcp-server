{
  "name": "@changepilot/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the ChangePilot reporting API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmpoweringCloud/changepilot-mcp-server.git"
  },
  "homepage": "https://portal.changepilot.cloud/mcp",
  "bugs": {
    "url": "https://github.com/EmpoweringCloud/changepilot-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "changepilot",
    "microsoft-365",
    "message-center",
    "roadmap"
  ],
  "type": "module",
  "bin": {
    "changepilot-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
